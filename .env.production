# EscolasApp Production Environment Configuration
# Used by: COMPOSE_ENV_FILE=.env.production docker-compose --profile production up -d
# WARNING: Keep all secrets secure - use GitHub Secrets or secure vault

MONGO_USER=admin
MONGO_PASSWORD=production-secure-password-CHANGE-ME
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=production-secure-password-CHANGE-ME
DB_NAME=escolasapp_prod
DB_HOST=mongodb
DB_PORT=27017
DB_URL=mongodb://admin:production-secure-password-CHANGE-ME@mongodb:27017/escolasapp_prod

NODE_ENV=production
PORT=3002
LOG_LEVEL=warn

# Production registry
DOCKER_REGISTRY_URL=ghcr.io/cemdevops/escolasapp

# Production analytics
GOOGLE_ANALYTICS_CODE=UA-PRODUCTION-XXXX
