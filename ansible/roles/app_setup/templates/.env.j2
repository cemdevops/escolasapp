# Generated environment file for {{ app_environment }} environment
# Auto-generated by Ansible - Do not edit manually

# Node.js & Application Settings
NODE_ENV={{ app_environment }}
APP_PORT={{ app_port }}
DEBUG={% if app_environment == 'development' %}escolasapp:*{% else %}{% endif %}

# Database Configuration
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_URL={{ db_url }}

# External Services
GOOGLE_ANALYTICS_CODE={{ google_analytics_code }}

# Docker Settings
COMPOSE_PROJECT_NAME={{ app_name }}-{{ app_environment }}

# Logging
LOG_LEVEL={{ log_level }}
