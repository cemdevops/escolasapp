# Generated docker-compose override for {{ app_environment }} environment
# Auto-generated by Ansible - Do not edit manually

version: '3.8'

services:
  app:
    environment:
      NODE_ENV: {{ app_environment }}
      DB_URL: {{ db_url }}
      LOG_LEVEL: {{ log_level }}
    ports:
      - "{{ app_port }}:3002"
{% if app_environment == 'development' %}
    volumes:
      - ./src:/app/src
      - ./routes:/app/routes
      - ./models:/app/models
      - ./app.js:/app/app.js
      - ./bin:/app/bin
      - /app/node_modules
    env_file:
      - .env
{% else %}
    restart: always
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
{% endif %}

  mongodb:
    environment:
      MONGO_INITDB_DATABASE: {{ db_name }}
      MONGO_INITDB_ROOT_USERNAME: {{ db_user }}
      MONGO_INITDB_ROOT_PASSWORD: {{ db_password }}
{% if app_environment == 'development' %}
    ports:
      - "27017:27017"
{% else %}
    ports: []
    restart: always
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
{% endif %}
