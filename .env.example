# Application Environment Variables Template
# Copy to .env.development.local, .env.staging.local, or .env.production.local
# and update with actual values for each environment

# ============================================================================
# Node.js & Application Settings
# ============================================================================

# Application environment: development, staging, production
NODE_ENV=development

# Application port
APP_PORT=3002

# Enable debug logging (leave empty for production)
DEBUG=escolasapp:*

# ============================================================================
# Database Configuration
# ============================================================================

# MongoDB connection settings
DB_HOST=mongodb
DB_PORT=27017
DB_NAME=escolasapp

# MongoDB authentication (optional for development)
DB_USER=admin
DB_PASSWORD=admin123

# Full MongoDB connection URL (overrides individual DB_* settings if provided)
# Format: mongodb://[username:password@]host:port/database
# Example: mongodb://admin:admin123@mongodb:27017/escolasapp
DB_URL=mongodb://mongodb:27017/escolasapp

# ============================================================================
# External Services
# ============================================================================

# Google Analytics tracking code
GOOGLE_ANALYTICS_CODE=UA-122157047-1

# ============================================================================
# Docker-specific Settings
# ============================================================================

# Compose project name (used for container/volume naming)
COMPOSE_PROJECT_NAME=escolasapp

# Compose profiles (e.g., optional services)
COMPOSE_PROFILES=

# ============================================================================
# Logging Configuration
# ============================================================================

# Application log level: error, warn, info, debug, verbose
LOG_LEVEL=debug

# ============================================================================
# Development & Debugging (Development Only)
# ============================================================================

# Enable verbose npm output
VERBOSE=false

# Enable Node.js debugger
NODE_DEBUG_ENABLED=false

# ============================================================================
# Notes
# ============================================================================

# For Development:
#   - Copy this file to: .env.development.local
#   - Set NODE_ENV=development
#   - MongoDB credentials can be simple (admin/admin123)
#   - DEBUG=escolasapp:* enables debug logging

# For Staging:
#   - Copy this file to: .env.staging.local
#   - Set NODE_ENV=staging
#   - Use strong MongoDB credentials
#   - Store sensitive values in ansible-vault encrypted vars

# For Production:
#   - Copy this file to: .env.production.local
#   - Set NODE_ENV=production
#   - Use very strong MongoDB credentials
#   - Debug logging should be empty
#   - Store sensitive values in ansible-vault encrypted vars

