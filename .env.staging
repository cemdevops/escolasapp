# EscolasApp Staging Environment Configuration
# Used by: docker-compose --profile staging up -d

MONGO_USER=admin
MONGO_PASSWORD=staging-secure-password-123
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=staging-secure-password-123
DB_NAME=escolasapp_staging
DB_HOST=mongodb
DB_PORT=27017
DB_URL=mongodb://admin:staging-secure-password-123@mongodb:27017/escolasapp_staging

NODE_ENV=staging
PORT=3002
LOG_LEVEL=info

DOCKER_REGISTRY_URL=ghcr.io/cemdevops/escolasapp

# Staging-specific analytics (if needed)
GOOGLE_ANALYTICS_CODE=UA-STAGING-XXXX
