# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
/out-tsc
.angular/
*.tsbuildinfo

# dependencies
/node_modules
package-lock.json
yarn.lock

# IDEs and editors
/.idea
/.vscode
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/extensions
.vscode/ipch
.history

# Text editor backups
*.swp
*.swo
*~
.~*

# JetBrains IDEs
.idea/
*.iml

# Vagrant
.vagrant/
.vagrant.d/
*.box
*.log

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
testem.log
/typings
lerna-debug.log
yarn-error.log
.npm
.eslintcache

# e2e
/e2e/*.js
/e2e/*.map

# System Files
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride
desktop.ini
$RECYCLE.BIN/

# Process files
*.pid
*.pid.lock

# configuration
/config

# Environment variables (local only, never commit)
.env
.env.local
.env.*.local
*.local

db/*
!db/README.md
